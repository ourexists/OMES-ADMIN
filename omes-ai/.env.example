# =========================
# OMES-AI Runtime Settings
# =========================

# Service
SERVER_PORT=10011

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=5s
REDIS_POOL_MAX_ACTIVE=50
REDIS_POOL_MAX_IDLE=20
REDIS_POOL_MIN_IDLE=5
REDIS_POOL_MAX_WAIT=2s

# Portal / Proxy
AI_PORTAL_BASE_URL=http://127.0.0.1:10010
AI_AGENT_PORTAL_PROXY_ENABLED=true

# Embedding model for knowledge retrieval
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Qdrant vector database support (set AGENT_VECTOR_PROVIDER=qdrant)
AGENT_VECTOR_PROVIDER=in-memory
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=omes_inspection_kb
QDRANT_API_KEY=
QDRANT_USE_TLS=false

# Multi-agent runtime file
# Use default chain:
# AI_AGENT_CHAIN_CONFIG_PATH=config/ai-agent-chain.json
# Use multi-provider chain:
AI_AGENT_CHAIN_CONFIG_PATH=config/ai-agent-chain.multi-provider.example.json

# =========================
# LLM Providers (OpenAI-compatible endpoints)
# =========================

# Global default provider used by ai.llm.default-provider
AI_DEFAULT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Qwen (DashScope OpenAI-compatible endpoint)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus

# Anthropic (set compatible gateway if used)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet

# Gemini (set compatible gateway if used)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL=gemini-1.5-pro

{
  "chainName": "equipment-orchestrator-flow",
  "entry": "orchestrator-router",
  "nodes": [
    {
      "id": "orchestrator-router",
      "type": "llm-router",
      "enabled": true,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "根据用户问题做意图解析并路由。只输出 route key：device/data/alarm/dispatch",
      "routes": {
        "device": "device-agent",
        "data": "data-agent",
        "alarm": "alarm-agent",
        "dispatch": "dispatch-agent"
      },
      "next": "dispatch-agent"
    },
    {
      "id": "device-agent",
      "type": "agent",
      "enabled": true,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "设备域分析Agent",
      "next": "orchestrator-aggregate"
    },
    {
      "id": "data-agent",
      "type": "agent",
      "enabled": true,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "数据域分析Agent（支持工具自动调用）",
      "next": "orchestrator-aggregate"
    },
    {
      "id": "alarm-agent",
      "type": "agent",
      "enabled": true,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "告警域分析Agent",
      "next": "orchestrator-aggregate"
    },
    {
      "id": "dispatch-agent",
      "type": "agent",
      "enabled": true,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "调度中心兜底Agent，处理不明确意图并给出可执行建议",
      "next": "orchestrator-aggregate"
    },
    {
      "id": "orchestrator-aggregate",
      "type": "llm",
      "enabled": true,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "你是Orchestrator，请聚合上游Agent结果，输出JSON对象：{summary:string,evidence:string[],actions:string[],selectedAgent:string}",
      "outputFormat": "json",
      "next": null
    },
    {
      "id": "final",
      "type": "llm",
      "enabled": false,
      "provider": "openai",
      "model": "gpt-4o-mini",
      "prompt": "可选最终汇总节点",
      "outputFormat": "json"
    }
  ]
}

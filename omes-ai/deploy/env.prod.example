# =========================
# OMES-AI Production Env
# Required and common knobs only
# =========================

# ---- Service ----
SERVER_PORT=10011

# ---- Redis (required) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- Portal upstream (required) ----
AI_PORTAL_BASE_URL=http://127.0.0.1:10010
AI_AGENT_PORTAL_PROXY_ENABLED=true

# ---- Embedding model (optional) ----
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector provider / Qdrant (optional) ----
AGENT_VECTOR_PROVIDER=in-memory
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=omes_inspection_kb
QDRANT_API_KEY=
QDRANT_USE_TLS=false

# ---- Multi-agent runtime config ----
# Recommend using multi-provider chain in production:
AI_AGENT_CHAIN_CONFIG_PATH=config/ai-agent-chain.multi-provider.example.json

# ---- LLM provider selection ----
# openai | deepseek | qwen | anthropic | gemini
AI_DEFAULT_PROVIDER=openai

# OpenAI (fill if any node uses provider=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# DeepSeek (fill if any node uses provider=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Qwen (fill if any node uses provider=qwen)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus

# Anthropic (optional, needs compatible gateway url if enabled)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet

# Gemini (optional, needs compatible gateway url if enabled)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL=gemini-1.5-pro

# =========================
# OMES-AI 生产环境变量模板（中文注释版）
# 说明：
# 1) 复制为实际环境变量文件或注入到部署平台
# 2) 仅需填写你编排链路里实际用到的 provider 的 API Key
# =========================

# ---- 服务端口 ----
SERVER_PORT=10011

# ---- Redis（必填）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DATABASE=0

# ---- Portal 上游地址（必填）----
AI_PORTAL_BASE_URL=http://127.0.0.1:10010
AI_AGENT_PORTAL_PROXY_ENABLED=true

# ---- Embedding 模型（可选）----
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- 向量检索 / Qdrant（可选）----
AGENT_VECTOR_PROVIDER=in-memory
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_COLLECTION=omes_inspection_kb
QDRANT_API_KEY=
QDRANT_USE_TLS=false

# ---- 多 Agent 编排配置文件 ----
# 建议线上直接使用多 provider 示例编排
AI_AGENT_CHAIN_CONFIG_PATH=config/ai-agent-chain.multi-provider.example.json

# ---- 默认 Provider（兜底）----
# 可选：openai | deepseek | qwen | anthropic | gemini
AI_DEFAULT_PROVIDER=openai

# ---- OpenAI（当任一节点 provider=openai 时必须填）----
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_CHAT_MODEL=gpt-4o-mini

# ---- DeepSeek（当任一节点 provider=deepseek 时必须填）----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---- Qwen（当任一节点 provider=qwen 时必须填）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus

# ---- Anthropic（可选；启用时需配置兼容网关地址）----
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet

# ---- Gemini（可选；启用时需配置兼容网关地址）----
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_CHAT_MODEL=gemini-1.5-pro

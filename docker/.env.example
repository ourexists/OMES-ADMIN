# Copy to docker/.env and adjust before `docker compose up`
# cp docker/.env.example docker/.env

OMES_IMAGE_TAG=latest

# --- PostgreSQL ---
POSTGRES_DB=omes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=waqwertyuiop!
REDIS_PORT=6379

# --- RabbitMQ ---
RABBITMQ_USERNAME=admin
RABBITMQ_PASSWORD=TyY6Df3bZe
RABBITMQ_VHOST=/
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- App ports (host) ---
ADMIN_PORT=10010
SAS_PORT=9400
WEB_PORT=8080

# --- JVM ---
ADMIN_JAVA_OPTS=-Xms512m -Xmx1024m
SAS_JAVA_OPTS=-Xms256m -Xmx512m

# --- Security (change in production) ---
OMES_INTERNAL_SERVICE_KEY=dev-internal-change-me
AI_BRIDGE_INTERNAL_KEY=dev-bridge-change-me
OMES_GATEWAY_ENABLED=true

# Browser-facing SAS URL baked into the Vue build (use host-accessible address)
VITE_SAS_BASE_URL=http://127.0.0.1:9400
VITE_APP_TITLE=OMES ADMIN

}

/* App：uvue 默认 view overflow:hidden，flex-wrap 换行会被裁切；须用单 class，勿用 .parent .child（App 不支持关系选择器） */
.aggregate-bar--app,
.aggregate-chips--app,
.aggregate-chip--app {
  overflow: visible;
}

.collect-table {
  display: flex;

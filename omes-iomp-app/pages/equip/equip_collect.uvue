  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
  width: 100%;
}

/* 聚合单元格文案较长；App 默认 white-space: keep + kv-value overflow:hidden 会裁掉「最大/样本」等后半段 */
.table-kv--aggregate {
  align-items: flex-start;
  flex-wrap: wrap;
}

.kv-label {
  font-size: 23rpx;
  color: #64748b;
  padding-right: 12rpx;
  flex: 1;
  text-align: left;
}

.kv-value {
  font-size: 24rpx;
  color: #334155;
  min-width: 120rpx;
  flex: 1;
  text-align: right;
  overflow: hidden;
}

.kv-value--aggregate {
  white-space: normal;
  overflow: visible;

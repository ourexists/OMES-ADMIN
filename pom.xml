<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ourexists.omes</groupId>
    <artifactId>omes-iomp</artifactId>
    <packaging>pom</packaging>
    <version>1.0.1-SNAPSHOT</version>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <modules>
        <module>omes-iomp-app</module>
        <module>omes-iomp-ai</module>
        <module>omes-iomp-device</module>
        <module>omes-iomp-inspection</module>
        <module>omes-iomp-line</module>
        <module>omes-iomp-mat</module>
        <module>omes-iomp-mo</module>
        <module>omes-iomp-mps</module>
        <module>omes-iomp-sync</module>
        <module>omes-iomp-task</module>
        <module>omes-iomp-ucenter</module>
        <module>omes-iomp-message</module>
        <module>omes-iomp-process</module>
        <module>omes-iomp-runner-admin</module>
        <module>omes-iomp-flinker-equip</module>
        <module>omes-iomp-flinker-workshop</module>
        <module>omes-iomp-runner-control</module>
        <module>omes-iomp-runner-sas</module>
        <module>omes-iomp-web-admin</module>
    </modules>

    <parent>
        <groupId>com.ourexists.era</groupId>
        <artifactId>era-parent</artifactId>
        <!-- keep in sync with era.version -->
        <version>2024.0.2.0-SNAPSHOT</version>
        <relativePath>../era/pom.xml</relativePath>
    </parent>

    <properties>
        <era.version>2024.0.2.0-SNAPSHOT</era.version>
        <era-framework-dependencies.version>${era.version}</era-framework-dependencies.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ourexists.era</groupId>
                <artifactId>era-framework-dependencies</artifactId>
                <version>${era-framework-dependencies.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
